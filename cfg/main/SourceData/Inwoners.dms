unit<uint32> Population
:	StorageName     = "='%Accessibility_DataDir%/Locations/cbs_vk100_'+ModelParameters/Populatie_jaar+'_vol.gpkg'" 
,	StorageType     = "gdal.vect"
,	SyncMode        = "AllTables"
,	StorageReadOnly = "True"
,	DialogType      = "map"
,	DialogData      = "centroid"
{
	attribute<rdc>                   geometry (poly);
	attribute<rdc>                   centroid         := centroid_or_mid(geometry);
	attribute<uint32>                nr_inhabitants   := aantal_inwoners[uint32];
	
	parameter<string>                Gridsize         := ModelParameters/Advanced/Dest_location_scale;
	unit<ipoint>                     domain           := ='rdc_'+Gridsize;
	
	attribute<domain>                domain_rel                      := centroid[domain];
	attribute<uint32>                sum_inhab_per_grid     (domain) := sum(nr_inhabitants, domain_rel);
	attribute<uint32>                sum_IsPositive         (domain) := sum_inhab_per_grid > 0 ? sum_inhab_per_grid : null_u;
	
	
	unit<uint32> HasInhabitants := select_uint32_with_attr_by_cond(., sum_IsPositive > 0)
	{
		attribute<rdc>    geometry            := collect_by_cond(., ../sum_IsPositive > 0, domain/geometry);
		attribute<uint32> identification      := id(.);
		attribute<string> id_name             := 'dest' + string(identification);
		attribute<string> label               := id_name;
		attribute<string> name                := label;
		
		attribute<uint32> nr_inhabitants      := sum_inhab_per_grid;
	} 
}